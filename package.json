{
  "name": "play-son",
  "description": "A declarative API testing framework built on Playwright",
  "version": "0.1.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playson": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GouravNG/Play-son.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@inquirer/prompts": "^8.4.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "jmespath": "^0.16.0",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "^3.14.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^25.6.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
