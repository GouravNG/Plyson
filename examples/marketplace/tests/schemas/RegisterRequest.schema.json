{
  "type": "object",
  "required": [
    "email",
    "password",
    "firstname",
    "lastname"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128
    },
    "firstname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lastname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "USER"
      ],
      "default": "USER"
    }
  }
}
