        "type": "object"
      }
    },
    "shippingAddress": {
      "type": "string",
      "nullable": true
    },
    "note": {
      "type": "string",
      "nullable": true
    },
    "cancelReason": {
      "type": "string",
      "nullable": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
