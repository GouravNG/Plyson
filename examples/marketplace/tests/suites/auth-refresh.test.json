{
  "title": "Auth Refresh",
  "description": "Tests for the /auth/refresh endpoint",
  "tags": ["automated", "auth", "refresh"],
  "testCases": [
    {
      "id": "auth-refresh-pos-001",
      "title": "Refresh token successfully with valid token",
      "testType": "positive",
      "tags": ["positive", "post", "auth"],
      "variables": {
        "refreshEmail": "refresh.{{$timestamp}}@example.com"
      },
      "steps": [
        {
          "title": "Register a new user",
          "request": {
            "method": "POST",
            "endpoint": "{{REGISTER_PATH}}",
            "payload": {
              "email": "{{refreshEmail}}",
              "password": "Password123",
              "firstname": "Refresh",
              "lastname": "Positive"
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            }
          }
        },
        {
          "title": "Login to get token",
          "request": {
            "method": "POST",
            "endpoint": "{{LOGIN_PATH}}",
            "payload": {
              "email": "{{refreshEmail}}",
              "password": "Password123"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200
            },
            "extract": [
              {
                "name": "refreshToken",
                "from": "body",
                "path": "$.token",
                "scope": "case"
              }
            ]
          }
        },
        {
          "title": "Refresh token",
          "request": {
            "method": "POST",
            "endpoint": "{{REFRESH_PATH}}",
            "headers": {
              "Authorization": "Bearer {{refreshToken}}"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Success is true",
                  "from": "body",
                  "path": "$.success",
                  "operator": "equals",
                  "value": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "auth-refresh-neg-unauthorized",
      "title": "Fail to refresh token without valid token",
      "testType": "negative",
      "tags": ["negative", "post", "auth"],
      "steps": [
        {
          "title": "Refresh attempt without token",
          "request": {
            "method": "POST",
            "endpoint": "{{REFRESH_PATH}}"
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401
            }
          }
        },
        {
          "title": "Refresh attempt with invalid token",
          "request": {
            "method": "POST",
            "endpoint": "{{REFRESH_PATH}}",
            "headers": {
              "Authorization": "Bearer invalid-token"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401
            }
          }
        }
      ]
    }
  ]
}
