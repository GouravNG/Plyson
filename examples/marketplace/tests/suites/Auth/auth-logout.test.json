{
  "$schema": "../../node_modules/play-son/schemas/testsuite.schema.json",
  "title": "Auth Logout",
  "description": "Tests for the /auth/logout endpoint",
  "tags": ["automated", "auth", "logout"],
  "testCases": [
    {
      "id": "auth-logout-pos-001",
      "title": "Logout successfully with valid token",
      "testType": "positive",
      "tags": ["positive", "post", "auth", "p1", "smoke", "regression", "e2e"],
      "variables": {
        "logoutEmail": {
          "$gen": "email",
          "provider": "example.com"
        },
        "logoutPassword": {
          "$gen": "alphanumeric",
          "length": "{{DEFAULT_PWD_LENGTH}}"
        }
      },
      "steps": [
        {
          "title": "Register a new user",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{logoutEmail}}",
              "password": "{{logoutPassword}}",
              "firstname": {
                "$gen": "firstName"
              },
              "lastname": {
                "$gen": "lastName"
              }
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            }
          }
        },
        {
          "title": "Login to get token",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": {
              "email": "{{logoutEmail}}",
              "password": "{{logoutPassword}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200
            },
            "extract": [
              {
                "name": "logoutToken",
                "from": "body",
                "path": "$.token",
                "scope": "case"
              }
            ]
          }
        },
        {
          "title": "Logout",
          "request": {
            "method": "POST",
            "endpoint": "/auth/logout",
            "headers": {
              "Authorization": "Bearer {{logoutToken}}"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Success is true",
                  "from": "body",
                  "path": "$.success",
                  "operator": "equals",
                  "value": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "auth-logout-neg-unauthorized",
      "title": "Fail to logout without valid token",
      "testType": "negative",
      "tags": ["negative", "post", "auth", "p2", "regression"],
      "steps": [
        {
          "title": "Logout attempt without token",
          "request": {
            "method": "POST",
            "endpoint": "/auth/logout"
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401
            }
          }
        },
        {
          "title": "Logout attempt with invalid token",
          "request": {
            "method": "POST",
            "endpoint": "/auth/logout",
            "headers": {
              "Authorization": "Bearer invalid-token"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401
            }
          }
        }
      ]
    }
  ]
}
