    {
      "id": "user-create-pos-email-trimmed",
      "title": "Create user with email containing whitespace (should be trimmed)",
      "testType": "positive",
      "tags": ["positive", "post", "user", "edge-case"],
      "steps": [
        {
          "title": "Create user with spaces in email",
          "request": {
            "method": "POST",
            "endpoint": "/user",

            "payload": {
              "email": "  spaceemail.{{$timestamp}}@playson.com  ",
              "password": "Password@123",
              "firstname": "Space",
              "lastname": "Email"
            }
          },
          "response": {
            "schema": {
              "name": "User"
            },
            "validations": {
              "statusCode": 201,
              "assertions": [
                {
                  "title": "Email is trimmed and lowercased",
                  "from": "body",
                  "path": "$.user.email",
                  "operator": "includes",
                  "value": "spaceemail"
                }
              ]
            }
          }
        }
      ]
    },
