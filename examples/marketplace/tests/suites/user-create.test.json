{
  "title": "User Create Account",
  "description": "Comprehensive tests for the POST /user endpoint - create new user account (authenticated)",
  "disabled": true,
  "tags": ["automated", "user", "post", "create"],
  "testCases": [
    {
      "id": "user-create-pos-001",
      "title": "Create new user with valid data while authenticated",
      "testType": "positive",
      "tags": ["positive", "post", "user", "create"],
      "steps": [
        {
          "title": "Create new user account with all required fields",
          "request": {
            "method": "POST",
            "endpoint": "/user",

            "payload": {
              "email": "newuser.{{$timestamp}}@playson.com",
              "password": "NewPass@123",
              "firstname": "John",
              "lastname": "Doe"
            }
          },
          "response": {
            "schema": {
              "name": "User"
            },
            "validations": {
              "statusCode": 201,
              "assertions": [
                {
                  "title": "User object exists in response",
                  "from": "body",
                  "path": "$.user",
                  "operator": "exists"
                },
                {
                  "title": "User has valid ID",
                  "from": "body",
                  "path": "$.user.id",
                  "operator": "exists"
                },
                {
                  "title": "Email is correctly set",
                  "from": "body",
                  "path": "$.user.email",
                  "operator": "includes",
                  "value": "newuser"
                },
                {
                  "title": "First name is John",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "John"
                },
                {
                  "title": "Last name is Doe",
                  "from": "body",
                  "path": "$.user.lastname",
                  "operator": "equals",
                  "value": "Doe"
                },
                {
                  "title": "Role defaults to USER",
                  "from": "body",
                  "path": "$.user.role",
                  "operator": "equals",
                  "value": "USER"
                },
                {
                  "title": "Status is INACTIVE",
                  "from": "body",
                  "path": "$.user.status",
                  "operator": "equals",
                  "value": "INACTIVE"
                },
                {
                  "title": "Password is not returned",
                  "from": "body",
                  "path": "$.user.password",
                  "operator": "notExists"
                }
              ]
            },
            "extract": [
              {
                "name": "createdNewUserId",
                "from": "body",
                "path": "$.user.id",
                "scope": "case"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "user-create-neg-no-auth",
      "title": "Fail to create user without authentication",
      "testType": "negative",
      "tags": ["negative", "post", "user", "auth"],
      "steps": [
        {
          "title": "Attempt to create user without authorization header",
          "request": {
            "method": "POST",
            "endpoint": "/user",
            "payload": {
              "email": "noauth.{{$timestamp}}@playson.com",
              "password": "Password@123",
              "firstname": "No",
              "lastname": "Auth"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401,
              "assertions": [
                {
                  "title": "Authentication error returned",
                  "from": "body",
                  "path": "$.error",
                  "operator": "exists"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "user-create-neg-invalid-token",
      "title": "Fail to create user with invalid token",
      "testType": "negative",
      "tags": ["negative", "post", "user", "auth"],
      "steps": [
        {
          "title": "Attempt to create user with malformed token",
          "request": {
            "method": "POST",
            "endpoint": "/user",
            "headers": {
              "Authorization": "Bearer invalid_token_xyz"
            },
            "payload": {
              "email": "invalidtoken.{{$timestamp}}@playson.com",
              "password": "Password@123",
              "firstname": "Invalid",
              "lastname": "Token"
            }
          },
          "response": {
            "schema": {
              "name": "Error"
            },
            "validations": {
              "statusCode": 401
            }
          }
        }
      ]
    },
