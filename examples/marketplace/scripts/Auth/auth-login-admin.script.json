{
  "$schema": "../../node_modules/playson/schemas/testcase.schema.json",
  "id": "TC_ADMIN_AUTH",
  "title": "Auth Login Admin",
  "tags": ["auth", "admin", "setup"],
  "description": "Register (if not exists) and login as an ADMIN, extracting the token to global scope",
  "steps": [
    {
      "title": "Register ADMIN if needed",
      "request": {
        "method": "POST",
        "endpoint": "/auth/register",
        "payload": {
          "email": "{{ADMIN_EMAIL}}",
          "password": "{{ADMIN_PASSWORD}}",
          "firstname": "System",
          "lastname": "Admin",
          "role": "ADMIN"
        }
      },
      "response": {
        "validations": {
          "statusCode": [201, 409]
        }
      }
    },
    {
      "title": "Login as ADMIN",
      "request": {
        "method": "POST",
        "endpoint": "/auth/login",
        "payload": {
          "email": "{{ADMIN_EMAIL}}",
          "password": "{{ADMIN_PASSWORD}}"
        }
      },
      "response": {
        "schema": {
          "name": "User"
        },
        "validations": {
          "statusCode": 200
        },
        "extract": [
          {
            "name": "adminToken",
            "from": "body",
            "path": "$.token",
            "scope": "global"
          }
        ]
      }
    }
  ]
}
