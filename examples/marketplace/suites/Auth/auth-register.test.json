    {
      "id": "auth-register-neg-duplicate-email",
      "title": "Fail to register with duplicate email",
      "testType": "negative",
      "tags": ["negative", "data-state", "p1", "regression", "e2e"],
      "steps": [
        {
          "title": "Register first user",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": {
                "$gen": "email"
              },
              "password": {
                "$gen": "alphanumeric",
                "length": "{{DEFAULT_PWD_LENGTH}}"
              },
              "firstname": {
                "$gen": "firstName"
              },
              "lastname": {
                "$gen": "lastName"
              }
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            },
            "extract": [
              {
                "name": "duplicateEmail",
                "from": "body",
                "path": "$.user.email",
                "scope": "case"
              }
            ]
          }
        },
        {
          "title": "Register second user with same email",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{duplicateEmail}}",
              "password": {
                "$gen": "alphanumeric",
                "length": "{{DEFAULT_PWD_LENGTH}}"
              },
              "firstname": {
                "$gen": "firstName"
              },
              "lastname": {
                "$gen": "lastName"
              }
            }
          },
          "response": {
            "validations": {
              "statusCode": 409,
              "assertions": [
                {
                  "title": "Success is false",
                  "from": "body",
                  "path": "$.success",
                  "operator": "equals",
                  "value": false
                },
                {
                  "title": "Error message matches",
                  "from": "body",
                  "path": "$.error",
                  "operator": "equals",
                  "value": "Email already registered"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "auth-register-edge-max-lengths",
      "title": "Register with maximum field lengths",
      "testType": "positive",
      "tags": ["edge", "boundary", "p3", "regression"],
      "steps": [
        {
          "title": "Max length validation",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": {
                "$gen": "email"
              },
              "firstname": {
                "$gen": "alpha",
                "length": "{{MAX_NAME_LENGTH}}"
              },
              "lastname": {
                "$gen": "alpha",
                "length": "{{MAX_NAME_LENGTH}}"
              },
              "password": {
                "$gen": "alphanumeric",
                "length": "{{MAX_PWD_LENGTH}}"
              }
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            }
          }
        }
      ]
