      ]
    },
    {
      "id": "auth-register-neg-missing-email",
      "title": "Fail to register without email",
      "testType": "negative",
      "tags": ["negative", "validation", "p2", "regression"],
      "steps": [
        {
          "title": "Missing email",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "password": {
                "$gen": "alphanumeric",
                "length": "{{DEFAULT_PWD_LENGTH}}"
              },
              "firstname": {
