{
  "$schema": "../../Project-schema/testsuite.schema.json",
  "title": "auth-controller",
  "description": "Comprehensive tests for the /auth/register endpoint",
  "tags": ["auth", "register", "user-onboarding", "critical"],
  "testCases": [
    {
      "id": "auth-register-pos-001",
      "title": "Register a new user with valid data (default role USER)",
      "testType": "positive",
      "tags": ["positive", "validation", "p1", "smoke", "regression", "e2e"],
      "steps": [
        {
          "title": "Register as USER",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": {
                "$gen": "email"
              },
              "password": {
                "$gen": "alphanumeric",
                "length": "{{DEFAULT_PWD_LENGTH}}"
              },
              "firstname": {
                "$gen": "firstName"
              },
              "lastname": {
                "$gen": "lastName"
              }
            }
          },
          "response": {
            "schema": {
              "name": "User2",
              "validation": "warn"
            },
            "validations": {
              "statusCode": 201,
              "assertions": [
                {
                  "title": "Success is true",
                  "from": "body",
                  "path": "$.success",
                  "operator": "equals",
                  "value": false,
                  "validation": "warn"
                },
                {
                  "title": "Role is USER",
                  "from": "body",
                  "path": "$.user.role",
                  "operator": "equals",
                  "value": "USER"
                },
                {
                  "title": "Status is INACTIVE",
                  "from": "body",
                  "path": "$.user.status",
                  "operator": "equals",
                  "value": "INACTIVE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "auth-register-pos-002",
      "title": "Register a new user explicitly as ADMIN",
      "testType": "positive",
      "tags": ["positive", "auth", "p1", "regression"],
