{
  "$schema": "../../Project-schema/testsuite.schema.json",
  "title": "User Controller - Patch",
  "description": "Tests for updating own profile (/user) via PATCH",
  "tags": ["user", "profile", "patch", "regression"],
  "beforeAll": [
    {
      "title": "Register test USER",
      "request": {
        "method": "POST",
        "endpoint": "/auth/register",
        "payload": {
          "email": { "$gen": "email", "provider": "patch-test.com" },
          "password": "Password123",
          "firstname": "Patch",
          "lastname": "User",
          "role": "USER"
        }
      },
      "response": {
        "validations": { "statusCode": 201 },
        "extract": [
          { "name": "suiteUserEmail", "from": "body", "path": "$.user.email", "scope": "suite" }
        ]
      }
    },
    {
      "title": "Login test USER",
      "request": {
        "method": "POST",
        "endpoint": "/auth/login",
        "payload": {
          "email": "{{suiteUserEmail}}",
          "password": "Password123"
        }
      },
      "response": {
        "validations": { "statusCode": 200 },
        "extract": [
          { "name": "suiteUserToken", "from": "body", "path": "$.token", "scope": "suite" }
        ]
      }
    },
    {
      "title": "Register test ADMIN",
      "request": {
        "method": "POST",
        "endpoint": "/auth/register",
        "payload": {
          "email": { "$gen": "email", "provider": "admin-patch-test.com" },
          "password": "Password123",
          "firstname": "Admin",
          "lastname": "Patch",
          "role": "ADMIN"
        }
      },
      "response": {
        "validations": { "statusCode": 201 },
        "extract": [
          { "name": "suiteAdminEmail", "from": "body", "path": "$.user.email", "scope": "suite" }
        ]
      }
    },
    {
      "title": "Login test ADMIN",
      "request": {
        "method": "POST",
        "endpoint": "/auth/login",
        "payload": {
          "email": "{{suiteAdminEmail}}",
          "password": "Password123"
        }
      },
      "response": {
        "validations": { "statusCode": 200 },
        "extract": [
          { "name": "suiteAdminToken", "from": "body", "path": "$.token", "scope": "suite" }
        ]
      }
    }
  ],
  "testCases": [
    {
      "id": "user-patch-pos-001",
      "title": "Update own profile names",
      "testType": "positive",
      "tags": ["positive", "patch", "user", "p1", "smoke"],
      "steps": [
        {
          "title": "Update firstname and lastname",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{suiteUserToken}}" },
            "autoFill": {
              "schemaName": "User",
              "excludeFields": ["password"]
            }
          },
          "response": {
            "schema": { "name": "User" },
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Firstname updated",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "Jane"
                },
                {
                  "title": "Lastname updated",
                  "from": "body",
                  "path": "$.user.lastname",
                  "operator": "equals",
                  "value": "Smith"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "user-patch-pos-002",
      "title": "Update own password and verify login",
      "testType": "positive",
      "tags": ["positive", "patch", "user", "auth", "p1"],
      "steps": [
        {
          "title": "Update password to 'NewPassword123'",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{suiteUserToken}}" },
            "payload": { "password": "NewPassword123" }
          },
          "response": { "validations": { "statusCode": 200 } }
        },
        {
          "title": "Verify login with new password",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": {
              "email": "{{suiteUserEmail}}",
              "password": "NewPassword123"
            }
          },
          "response": {
            "validations": { "statusCode": 200 },
            "extract": [
              { "name": "suiteUserToken", "from": "body", "path": "$.token", "scope": "suite" }
            ]
          }
        }
      ]
    },
    {
      "id": "user-patch-neg-validation",
      "title": "Fail to update profile with invalid data",
      "testType": "negative",
      "tags": ["negative", "patch", "user", "validation", "p2"],
      "steps": [
        {
          "title": "Short password (too short)",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{suiteUserToken}}" },
            "payload": { "password": "123" }
          },
          "response": {
            "validations": {
              "statusCode": 422,
              "assertions": [
                {
                  "title": "Error message for password length",
                  "from": "body",
                  "path": "$.errors",
                  "operator": "includes",
                  "value": "'password' must be at least 6 characters"
                }
              ]
            }
          }
        },
        {
          "title": "Empty firstname (minLength 1)",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{suiteUserToken}}" },
            "payload": { "firstname": "" }
          },
          "response": {
            "validations": {
              "statusCode": 422,
              "assertions": [
                {
                  "title": "Error message for empty firstname",
                  "from": "body",
                  "path": "$.errors",
                  "operator": "includes",
                  "value": "'firstname' must be at least 1 characters"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "user-patch-neg-unauthorized",
      "title": "Fail to update profile without valid token",
      "testType": "negative",
      "tags": ["negative", "patch", "user", "unauthorized", "p2"],
      "steps": [
        {
          "title": "No token provided",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "payload": { "firstname": "Anonymous" }
          },
          "response": { "validations": { "statusCode": 401 } }
        },
        {
          "title": "Invalid token format",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer invalid-token" },
            "payload": { "firstname": "Hacker" }
          },
          "response": { "validations": { "statusCode": 401 } }
        }
      ]
    },
    {
      "id": "user-patch-neg-forbidden",
      "title": "Fail to update profile with ADMIN role",
      "testType": "negative",
      "tags": ["negative", "patch", "user", "forbidden", "p2"],
      "steps": [
        {
          "title": "ADMIN token attempt on /user endpoint",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{suiteAdminToken}}" },
            "payload": { "firstname": "AdminUpdate" }
          },
          "response": { "validations": { "statusCode": 403 } }
        }
      ]
    },
    {
      "id": "user-patch-pos-isolation",
      "title": "Ensure profile update isolation between users",
      "testType": "positive",
      "tags": ["positive", "patch", "user", "security", "p1"],
      "variables": {
        "userA_Email": { "$gen": "email", "provider": "user-a.com" },
        "userB_Email": { "$gen": "email", "provider": "user-b.com" }
      },
      "steps": [
        {
          "title": "Register User A",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{userA_Email}}",
              "password": "Password123",
              "firstname": "User",
              "lastname": "Alpha"
            }
          },
          "response": { "validations": { "statusCode": 201 } }
        },
        {
          "title": "Register User B",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{userB_Email}}",
              "password": "Password123",
              "firstname": "User",
              "lastname": "Beta"
            }
          },
          "response": {
            "validations": { "statusCode": 201 },
            "extract": [
              { "name": "userB_Id", "from": "body", "path": "$.user.id", "scope": "case" }
            ]
          }
        },
        {
          "title": "Login as User A",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": { "email": "{{userA_Email}}", "password": "Password123" }
          },
          "response": {
            "validations": { "statusCode": 200 },
            "extract": [
              { "name": "userA_Token", "from": "body", "path": "$.token", "scope": "case" }
            ]
          }
        },
        {
          "title": "User A attempts to 'inject' User B's ID in payload",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{userA_Token}}" },
            "payload": {
              "id": "{{userB_Id}}",
              "firstname": "UpdatedAlpha"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "User A's name is updated",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "UpdatedAlpha"
                },
                {
                  "title": "ID remained User A's ID (not overwritten by B's)",
                  "from": "body",
                  "path": "$.user.id",
                  "operator": "notEquals",
                  "value": "{{userB_Id}}"
                }
              ]
            }
          }
        },
        {
          "title": "Login as User B and verify profile is unchanged",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": { "email": "{{userB_Email}}", "password": "Password123" }
          },
          "response": {
            "validations": { "statusCode": 200 },
            "extract": [
              { "name": "userB_Token", "from": "body", "path": "$.token", "scope": "case" }
            ]
          }
        },
        {
          "title": "Get User B profile",
          "request": {
            "method": "GET",
            "endpoint": "/auth/me",
            "headers": { "Authorization": "Bearer {{userB_Token}}" }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "User B firstname is still 'User'",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "User"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "user-patch-pos-isolation-fail",
      "title": "Ensure profile update isolation between users",
      "testType": "positive",
      "annotations": "fail",
      "tags": ["positive", "patch", "user", "security", "p1"],
      "variables": {
        "userA_Email": { "$gen": "email", "provider": "user-a.com" },
        "userB_Email": { "$gen": "email", "provider": "user-b.com" }
      },
      "steps": [
        {
          "title": "Register User A",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{userA_Email}}",
              "password": "Password123",
              "firstname": "User",
              "lastname": "Alpha"
            }
          },
          "response": { "validations": { "statusCode": 202 } }
        },
        {
          "title": "Register User B",
          "request": {
            "method": "POST",
            "endpoint": "/auth/register",
            "payload": {
              "email": "{{userB_Email}}",
              "password": "Password123",
              "firstname": "User",
              "lastname": "Beta"
            }
          },
          "response": {
            "validations": { "statusCode": 201 },
            "extract": [
              { "name": "userB_Id", "from": "body", "path": "$.user.id", "scope": "case" }
            ]
          }
        },
        {
          "title": "Login as User A",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": { "email": "{{userA_Email}}", "password": "Password123" }
          },
          "response": {
            "validations": { "statusCode": 200 },
            "extract": [
              { "name": "userA_Token", "from": "body", "path": "$.token", "scope": "case" }
            ]
          }
        },
        {
          "title": "User A attempts to 'inject' User B's ID in payload",
          "request": {
            "method": "PATCH",
            "endpoint": "/user",
            "headers": { "Authorization": "Bearer {{userA_Token}}" },
            "payload": {
              "id": "{{userB_Id}}",
              "firstname": "UpdatedAlpha"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "User A's name is updated",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "UpdatedAlpha"
                },
                {
                  "title": "ID remained User A's ID (not overwritten by B's)",
                  "from": "body",
                  "path": "$.user.id",
                  "operator": "notEquals",
                  "value": "{{userB_Id}}"
                }
              ]
            }
          }
        },
        {
          "title": "Login as User B and verify profile is unchanged",
          "request": {
            "method": "POST",
            "endpoint": "/auth/login",
            "payload": { "email": "{{userB_Email}}", "password": "Password123" }
          },
          "response": {
            "validations": { "statusCode": 200 },
            "extract": [
              { "name": "userB_Token", "from": "body", "path": "$.token", "scope": "case" }
            ]
          }
        },
        {
          "title": "Get User B profile",
          "request": {
            "method": "GET",
            "endpoint": "/auth/me",
            "headers": { "Authorization": "Bearer {{userB_Token}}" }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "User B firstname is still 'User'",
                  "from": "body",
                  "path": "$.user.firstname",
                  "operator": "equals",
                  "value": "User"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
