            }
          }
        }
      ]
    },
    {
      "id": "TC_FOUND12_001",
      "title": "Create a catalog with the minimum valid name length when store is active -> 201 Created",
      "testType": "edge",
      "tags": ["boundary", "positive", "post", "foundation", "p1"],
      "variables": {
        "catalogNameMin": {
          "$gen": "alpha",
          "length": 1
        }
      },
      "steps": [
        {
          "title": "Create catalog using a 1-character name",
          "request": {
            "method": "POST",
            "endpoint": "/foundation/catalog",
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            },
            "payload": {
              "name": "{{catalogNameMin}}",
              "storeId": "{{activeStoreId}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 201,
              "assertions": [
                {
                  "title": "Returned catalog name matches the request",
                  "from": "body",
                  "path": "$.catalog.name",
                  "operator": "equals",
                  "value": "{{catalogNameMin}}"
                },
                {
                  "title": "Returned catalog is linked to the requested store",
                  "from": "body",
                  "path": "$.catalog.storeId",
                  "operator": "equals",
                  "value": "{{activeStoreId}}"
                },
                {
                  "title": "Catalog ID is generated",
                  "from": "body",
                  "path": "$.catalog.id",
                  "operator": "exists"
                }
              ]
            }
          }
        }
      ]
    },
    {
