{
  "$schema": "../../Project-schema/testsuite.schema.json",
  "title": "Foundation - Catalog Management",
  "description": "Comprehensive tests for the /foundation/catalog endpoint",
  "tags": ["automated", "foundation", "catalog"],
  "beforeAll": [
    {
      "title": "Create a test business for catalog fixtures",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/business",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Business"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "activeBizId",
            "from": "body",
            "path": "$.business.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Create the primary active store for catalog fixtures",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/store",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Store",
          "businessId": "{{activeBizId}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "activeStoreId",
            "from": "body",
            "path": "$.store.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Create the secondary active store for reassignment tests",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/store",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Secondary Store",
          "businessId": "{{activeBizId}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "secondaryStoreId",
            "from": "body",
            "path": "$.store.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Create and delete a store for inactive-store validation",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/store",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Deleted Store",
          "businessId": "{{activeBizId}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "deletedStoreId",
            "from": "body",
            "path": "$.store.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Soft delete the inactive store fixture",
      "request": {
        "method": "DELETE",
        "endpoint": "/foundation/store/{{deletedStoreId}}",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 200
        }
      }
    },
    {
      "title": "Create an active catalog fixture",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/catalog",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Active",
          "storeId": "{{activeStoreId}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "activeCatalogId",
            "from": "body",
            "path": "$.catalog.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Create and delete a catalog fixture for soft-delete validation",
      "request": {
        "method": "POST",
        "endpoint": "/foundation/catalog",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        },
        "payload": {
          "name": "Catalog Suite Deleted",
          "storeId": "{{activeStoreId}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 201
        },
        "extract": [
          {
            "name": "deletedCatalogId",
            "from": "body",
            "path": "$.catalog.id",
            "scope": "suite"
          }
        ]
      }
    },
    {
      "title": "Soft delete the deleted-catalog fixture",
      "request": {
        "method": "DELETE",
        "endpoint": "/foundation/catalog/{{deletedCatalogId}}",
        "headers": {
          "Authorization": "Bearer {{adminToken}}"
        }
      },
      "response": {
        "validations": {
          "statusCode": 200
        }
      }
    }
  ],
  "testCases": [
    {
      "id": "TC_FOUND11_001",
      "title": "List catalogs as Admin when requesting the active collection -> 200 OK",
      "testType": "positive",
      "tags": ["positive", "get", "foundation", "p0", "smoke"],
      "steps": [
        {
          "title": "List catalogs with pagination",
          "request": {
            "method": "GET",
            "endpoint": "/foundation/catalog",
            "queryParams": {
              "page": 1,
              "limit": 100
            },
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Catalogs array is present",
                  "from": "body",
                  "path": "$.catalogs",
                  "operator": "exists"
                },
                {
                  "title": "Pagination metadata is present",
                  "from": "body",
                  "path": "$.meta",
                  "operator": "exists"
                },
                {
                  "title": "Deleted catalog records are excluded from the list",
                  "from": "body",
                  "path": "$.catalogs[?(@.deletedAt != null)]",
                  "operator": "notExists"
                },
                {
                  "title": "Requested page is reflected in metadata",
                  "from": "body",
                  "path": "$.meta.page",
                  "operator": "equals",
                  "value": 1
                },
                {
                  "title": "Requested limit is reflected in metadata",
                  "from": "body",
                  "path": "$.meta.limit",
                  "operator": "equals",
                  "value": 100
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "TC_FOUND11_002",
      "title": "Reject list catalogs when caller is not Admin -> 403 Forbidden",
      "testType": "negative",
      "tags": ["negative", "security", "foundation", "p0"],
      "steps": [
        {
          "title": "Attempt to list catalogs as a standard user",
          "request": {
            "method": "GET",
            "endpoint": "/foundation/catalog",
            "headers": {
              "Authorization": "Bearer {{userToken}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 403
            }
          }
        }
      ]
    },
    {
      "id": "TC_FOUND11_003",
      "title": "Reject list catalogs when unauthenticated -> 401 Unauthorized",
      "testType": "negative",
      "tags": ["negative", "security", "foundation", "p0"],
      "steps": [
        {
          "title": "Attempt to list catalogs without a bearer token",
          "request": {
            "method": "GET",
            "endpoint": "/foundation/catalog"
          },
          "response": {
