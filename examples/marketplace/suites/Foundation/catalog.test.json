    {
      "id": "TC_FOUND14_001",
      "title": "Update a catalog name when only name is provided -> 200 OK",
      "testType": "positive",
      "tags": ["positive", "patch", "foundation", "p0", "smoke"],
      "variables": {
        "updateNameCatalog": {
          "$gen": "alpha",
          "length": 12
        },
        "updatedCatalogName": {
          "$gen": "alpha",
          "length": 14
        }
      },
      "steps": [
        {
          "title": "Create a temporary catalog to update",
          "request": {
            "method": "POST",
            "endpoint": "/foundation/catalog",
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            },
            "payload": {
              "name": "{{updateNameCatalog}}",
              "storeId": "{{activeStoreId}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            },
            "extract": [
              {
                "name": "updateNameCatalogId",
                "from": "body",
                "path": "$.catalog.id",
                "scope": "case"
              }
            ]
          }
        },
        {
          "title": "Update only the catalog name",
          "request": {
            "method": "PATCH",
            "endpoint": "/foundation/catalog/{{updateNameCatalogId}}",
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            },
            "payload": {
              "name": "{{updatedCatalogName}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Name is updated",
                  "from": "body",
                  "path": "$.catalog.name",
                  "operator": "equals",
                  "value": "{{updatedCatalogName}}"
                },
                {
                  "title": "Store association remains unchanged",
                  "from": "body",
                  "path": "$.catalog.storeId",
                  "operator": "equals",
                  "value": "{{activeStoreId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "TC_FOUND14_002",
      "title": "Update a catalog store association when a new active store is provided -> 200 OK",
      "testType": "positive",
      "tags": ["positive", "patch", "foundation", "p1"],
      "variables": {
        "updateStoreCatalog": {
          "$gen": "alpha",
          "length": 12
        }
      },
      "steps": [
        {
          "title": "Create a temporary catalog to reassign",
          "request": {
            "method": "POST",
            "endpoint": "/foundation/catalog",
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            },
            "payload": {
              "name": "{{updateStoreCatalog}}",
              "storeId": "{{activeStoreId}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 201
            },
            "extract": [
              {
                "name": "updateStoreCatalogId",
                "from": "body",
                "path": "$.catalog.id",
                "scope": "case"
              }
            ]
          }
        },
        {
          "title": "Reassign the catalog to a different active store",
          "request": {
            "method": "PATCH",
            "endpoint": "/foundation/catalog/{{updateStoreCatalogId}}",
            "headers": {
              "Authorization": "Bearer {{adminToken}}"
            },
            "payload": {
              "storeId": "{{secondaryStoreId}}"
            }
          },
          "response": {
            "validations": {
              "statusCode": 200,
              "assertions": [
                {
                  "title": "Store association is updated",
                  "from": "body",
                  "path": "$.catalog.storeId",
                  "operator": "equals",
