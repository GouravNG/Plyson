{
  "name": "@playson/cli",
  "version": "0.1.4",
  "description": "Command-line interface for the Playson declarative API testing framework",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "bin": {
    "playson": "bin/playson.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GouravNG/Playson.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "testing",
    "api",
    "JSON",
    "automation",
    "playwright",
    "declarative",
    "cli"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@playson/test": "workspace:*",
    "commander": "^14.0.3",
    "jsonrepair": "^3.14.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
