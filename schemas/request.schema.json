{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTTP Request Configuration",
  "description": "Defines the HTTP request parameters including method, endpoint, headers, query parameters, and payload.",
  "type": "object",
  "required": ["method", "endpoint"],
  "properties": {
    "method": {
      "type": "string",
      "title": "HTTP Method",
      "description": "HTTP methods supported in the test steps",
      "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
      "examples": ["GET", "POST", "PUT"]
    },
    "endpoint": {
      "type": "string",
      "title": "Endpoint",
      "description": "API endpoint path (relative to baseUrl in environment config)",
      "examples": ["/users", "/api/v1/products/{id}", "/auth/login"]
    },
    "queryParams": {
      "type": "object",
      "title": "Query Parameters",
      "description": "Query string parameters to be appended to the URL",
      "additionalProperties": true,
      "examples": [
        {
          "page": 1,
          "limit": 10,
          "sort": "created_at"
        }
      ]
    },
    "pathParams": {
      "type": "object",
      "title": "Path Parameters",
      "description": "Dynamic path parameters to replace placeholders in the endpoint (e.g., {id})",
      "additionalProperties": true,
      "examples": [
        {
          "id": "123",
          "userId": "456"
        }
      ]
    },
    "headers": {
      "type": "object",
      "title": "Headers",
      "description": "HTTP request headers",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      },
      "examples": [
        {
          "Content-Type": "application/json",
          "Authorization": "Bearer token123",
          "X-Request-ID": "req-123456"
        }
      ]
    },
    "autoFill": {
      "title": "Auto Fill Configuration",
      "description": "Auto fill property helps in automatic fill of the request payload values from the request schema (extracted from Swagger or OpenAPI spec) based on the configuration provided. payload and autoFill work as JS spread operator where autoFill will fill the payload first and then payload will override those values.",
      "oneOf": [
        {
          "type": "boolean",
          "enum": [false]
        },
        {
          "type": "object",
          "required": ["schemaName"],
          "properties": {
            "schemaName": {
              "type": "string",
              "description": "Name of the request schema from OpenAPI/Swagger spec"
            },
            "includeFields": {
              "type": "array",
              "description": "Only include these specific fields from the request schema",
              "items": {
                "type": "string"
              },
              "examples": [["id", "name", "email"]]
            },
            "excludeFields": {
              "type": "array",
              "description": "Include all fields from request schema except these specified fields",
              "items": {
                "type": "string"
              },
              "examples": [["password", "secretKey", "internalId"]]
            }
          }
        }
      ],
      "examples": [
        false,
        {
          "schemaName": "CreateUserRequest"
        },
        {
          "schemaName": "CreateUserRequest",
          "includeFields": ["name", "email", "phone"]
        },
        {
          "schemaName": "UpdateProductRequest",
          "excludeFields": ["createdAt", "deletedAt"]
        }
      ]
    },
    "payload": {
      "title": "Request Payload",
      "description": "Request body payload. This will override any values from autoFill in case of conflicts.",
      "type": "object",
      "examples": [
        {
          "name": "John Doe",
          "email": "john@example.com",
          "age": 30
        },
        {
          "username": "johndoe",
          "password": {
            "$gen": "password"
          },
          "terms_accepted": true
        }
      ]
    }
  },
  "examples": [
    {
      "method": "GET",
      "endpoint": "/api/v1/users"
    },
    {
      "method": "POST",
      "endpoint": "/api/v1/users",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer token123"
      },
      "payload": {
        "name": "Jane Doe",
        "email": "jane@example.com",
        "role": "admin"
      }
    },
    {
      "method": "GET",
      "endpoint": "/api/v1/users/{userId}",
      "pathParams": {
        "userId": "123"
      }
    },
    {
      "method": "PUT",
      "endpoint": "/api/v1/products/{id}",
      "pathParams": {
        "id": "product-456"
      },
      "autoFill": {
        "schemaName": "UpdateProductRequest",
        "excludeFields": ["createdAt", "id"]
      },
      "payload": {
        "name": "Updated Product Name",
        "price": 99.99
      }
    },
    {
      "method": "DELETE",
      "endpoint": "/api/v1/users/{id}",
      "pathParams": {
        "id": "123"
      },
      "headers": {
        "Authorization": "Bearer admin-token"
      }
    }
  ]
}
