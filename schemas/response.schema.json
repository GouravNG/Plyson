{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTTP Response Configuration",
  "description": "Defines response validation including schema validation, assertions, status codes, and value extraction",
  "type": "object",
  "required": ["validations"],
  "properties": {
    "schema": {
      "type": "object",
      "title": "Response Schema Validation",
      "description": "Response schema validation configuration. Validation can be boolean or 'warn' which is useful in finding breaking changes earliest.",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the response schema from OpenAPI/Swagger specification"
        },
        "validation": {
          "type": ["boolean", "string"],
          "enum": [true, false, "warn"],
          "default": true,
          "description": "If true, schema validation errors are marked as errors. If 'warn', they are marked as warnings. Default is true."
        }
      },
      "examples": [
        {
          "name": "CreateUserResponse"
        },
        {
          "name": "GetProductResponse",
          "validation": true
        },
        {
          "name": "ListUsersResponse",
          "validation": "warn"
        }
      ]
    },
    "validations": {
      "type": "array",
      "title": "Response Validations",
      "description": "Array of status code validations and their associated assertions",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statusCode"],
        "properties": {
          "statusCode": {
            "title": "Status Code",
            "description": "Can be a single status code or an array of status codes",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                }
              }
            ],
            "examples": [200, [200, 201], [400, 401, 403]]
          },
          "assertions": {
            "type": "array",
            "title": "Assertions",
            "description": "Array of assertions to validate the response",
            "items": {
              "$ref": "assertions.schema.json"
            }
          }
        }
      },
      "examples": [
        [
          {
            "statusCode": 200,
            "assertions": [
              {
                "title": "Response has user ID",
                "from": "body",
                "path": "data.id",
                "operator": "exists"
              }
            ]
          }
        ]
      ]
    },
    "extract": {
      "type": "array",
      "title": "Extract Values",
      "description": "Array of values to extract from the response and store as variables",
      "items": {
        "type": "object",
        "required": ["name", "from", "path", "scope"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the variable to store the extracted value"
          },
          "from": {
            "type": "string",
            "enum": ["body", "header"],
            "description": "Whether to extract from response body or header"
          },
          "path": {
            "type": "string",
            "description": "JSONPath, JMESPath, or header key name to extract from"
          },
          "scope": {
            "type": "string",
            "enum": ["case", "suite", "global"],
            "description": "Scope at which to store the extracted variable - case, suite, or global level"
          }
        }
      },
      "examples": [
        [
          {
            "name": "userId",
            "from": "body",
            "path": "data.id",
            "scope": "suite"
          },
          {
            "name": "authToken",
            "from": "header",
            "path": "X-Auth-Token",
            "scope": "global"
          }
        ]
      ]
    }
  },
  "examples": [
    {
      "validations": [
        {
          "statusCode": 200
        }
      ]
    },
    {
      "schema": {
        "name": "CreateUserResponse",
        "validation": true
      },
      "validations": [
        {
          "statusCode": 201,
          "assertions": [
            {
              "title": "User ID is present",
              "from": "body",
              "path": "id",
              "operator": "exists"
            },
            {
              "title": "Email matches request",
              "from": "body",
              "path": "email",
              "operator": "isEquals",
              "value": "user@example.com"
            }
          ]
        },
        {
          "statusCode": [400, 409],
          "assertions": [
            {
              "title": "Error message present",
              "from": "body",
              "path": "error",
              "operator": "exists"
            }
          ]
        }
      ],
      "extract": [
        {
          "name": "newUserId",
          "from": "body",
          "path": "id",
          "scope": "suite"
        },
        {
          "name": "authToken",
          "from": "header",
          "path": "Authorization",
          "scope": "global"
        }
      ]
    },
    {
      "schema": {
        "name": "ListProductsResponse",
        "validation": "warn"
      },
      "validations": [
        {
          "statusCode": 200,
          "assertions": [
            {
              "title": "Response is array",
              "from": "body",
              "path": "$",
              "operator": "isArray"
            },
            {
              "title": "At least one product returned",
              "from": "body",
              "path": "$",
              "operator": "hasLengthGreaterThan",
              "value": 0
            }
          ]
        }
      ]
    }
  ]
}
